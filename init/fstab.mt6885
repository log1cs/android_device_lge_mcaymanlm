# Android fstab file.
#<src>                                                 <mnt_point>             <type>          <mnt_flags and options>                                                   <fs_mgr_flags>
system                                                 /system                 ext4            ro                                                                        wait,slotselect,avb=vbmeta,logical,first_stage_mount
system_ext                                             /system_ext             ext4            ro                                                                        wait,slotselect,avb=vbmeta,logical,first_stage_mount
odm                                                    /odm                    ext4            ro                                                                        wait,slotselect,avb,logical,first_stage_mount
vendor                                                 /vendor                 ext4            ro                                                                        wait,slotselect,avb,logical,first_stage_mount
product                                                /product                ext4            ro                                                                        wait,slotselect,avb,logical,first_stage_mount

/dev/block/by-name/vbmeta                              /vbmeta                 emmc            defaults                                                                  defaults,slotselect
/dev/block/by-name/vbmeta_system                       /vbmeta_system          emmc            defaults                                                                  first_stage_mount,nofail,slotselect,avb=vbmeta
/dev/block/by-name/vbmeta_vendor                       /vbmeta_vendor          emmc            defaults                                                                  first_stage_mount,nofail,slotselect

/dev/block/by-name/boot                                /boot                   emmc            defaults                                                                  first_stage_mount,nofail,slotselect
/dev/block/by-name/dtbo                                /dtbo                   emmc            defaults                                                                  defaults,slotselect

/dev/block/platform/bootdevice/by-name/md_udc          /metadata               ext4            noatime,nosuid,nodev,discard                                              wait,formattable,first_stage_mount
/dev/block/platform/bootdevice/by-name/userdata        /data                   f2fs            noatime,nosuid,nodev,discard,fsync_mode=nobarrier,reserve_root=32768,resgid=1065,inlinecrypt latemount,wait,check,formattable,quota,resize,reservedsize=128M,fileencryption=aes-256-xts:aes-256-cts,checkpoint=fs

/dev/block/platform/bootdevice/by-name/nvcfg           /mnt/vendor/nvcfg       ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc                  wait,check,formattable
/dev/block/platform/bootdevice/by-name/nvdata          /mnt/vendor/nvdata      ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc                  wait,check,formattable
/dev/block/platform/bootdevice/by-name/persist         /mnt/vendor/persist     ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc                  wait,check,formattable
/dev/block/platform/bootdevice/by-name/protect1        /mnt/vendor/protect_f   ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc                  wait,check,formattable
/dev/block/platform/bootdevice/by-name/protect2        /mnt/vendor/protect_s   ext4            ro,noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc               wait,formattable
/dev/block/platform/bootdevice/by-name/logo            /logo                   emmc            defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/nvram           /nvram                  emmc            defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/proinfo         /proinfo                emmc            defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/misc            /misc                   emmc            defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/misc2           /misc2                  emmc            defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/para            /para                   emmc            defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/frp             /persistent             emmc            defaults                                                                  defaults

/dev/block/platform/bootdevice/by-name/lk              /bootloader            emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/lk2             /bootloader2           emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/tee1            /tee1                  emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/tee2            /tee2                  emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/scp1            /scp1                  emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/scp2            /scp2                  emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/sspm_1          /sspm_1                emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/sspm_2          /sspm_2                emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/dpm_1           /dpm_1                 emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/dpm_2           /dpm_2                 emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/gz1             /gz1                   emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/gz2             /gz2                   emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/mcupm_1         /mcupm_1               emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/mcupm_2         /mcupm_2               emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/md1img          /md1img                emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/md1dsp          /md1dsp                emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/md1arm7         /md1arm7               emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/md3img          /md3img                emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/spmfw           /spmfw                 emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/audio_dsp       /audio_dsp             emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/boot_para       /boot_para             emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/pi_img          /pi_img                emmc             defaults                                                                  defaults

/dev/block/platform/bootdevice/by-name/expdb           /expdb                 emmc             defaults                                                                  defaults
/dev/block/platform/bootdevice/by-name/seccfg          /seccfg                emmc             defaults                                                                  defaults

/dev/block/platform/bootdevice/by-name/persist_lg      /mnt/vendor/persist-lg  ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc,errors=continue  wait,check,formattable,first_stage_mount
/dev/block/platform/bootdevice/by-name/power           /mnt/vendor/power       ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc,errors=continue  wait,check,formattable
/dev/block/platform/bootdevice/by-name/p_persist_lg    /mnt/product/persist-lg ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc,errors=continue  wait,check,formattable
/dev/block/platform/bootdevice/by-name/mpt             /mnt/product/mpt        ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc,errors=continue  wait,check,formattable
/dev/block/platform/bootdevice/by-name/carrier         /mnt/product/carrier    ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc,errors=continue  wait,check,formattable
/dev/block/platform/bootdevice/by-name/els             /mnt/product/els        ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc,errors=continue  wait,check,formattable
/dev/block/platform/bootdevice/by-name/srtc            /mnt/product/srtc       ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc,errors=continue  wait,check,formattable
/dev/block/platform/bootdevice/by-name/eri             /mnt/product/eri        ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc,errors=continue  wait,check,formattable
/dev/block/platform/bootdevice/by-name/operatorlogging /mnt/product/quality    ext4            noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc,errors=continue  wait,check,formattable
/dev/block/platform/bootdevice/by-name/OP              /mnt/product/OP         ext4            ro,noatime,nosuid,nodev,barrier=1,data=ordered,noauto_da_alloc            wait,avb,slotselect,nofail,first_stage_mount

/devices/platform/externdevice*                        auto                    auto            defaults                                                                  voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/11200000.usb_xhci*                   auto                    vfat            defaults                                                                  voldmanaged=usbotg:auto

/dev/block/zram0                                       none                    swap            defaults                                                                  zramsize=2147483648,max_comp_streams=8
