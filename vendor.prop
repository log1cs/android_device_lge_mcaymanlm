ro.vendor.pq.mtk_pq_video_whitelist_support=0
ro.vendor.pq.mtk_scltm_support=0
ro.vendor.pq.mtk_ultra_dimming_support=0
ro.vendor.pq.mtk_ultra_resolution_support=1
ro.vendor.pq.mtk_video_transition=0
ro.vendor.pref_scale_enable_cfg=1

# DRM
drm.service.enabled=true
ro.netflix.bsp_rev=MTK6885-31782-1
ro.vendor.drm.kbf.path=/mnt/vendor/persist-lg/widevine
ro.vendor.mtk_sec_video_path_support=1
ro.vendor.mtk_widevine_drm_l1_support=1
ro.vendor.widevine_wrapped_keybox_path=/mnt/vendor/persist-lg/widevine/

# Factory Reset Protection
ro.frp.pst=/dev/block/platform/bootdevice/by-name/frp

# FM Radio
persist.vendor.connsys.fm_chipid=mt6635
ro.vendor.builtin_fm_antenna_support=1
ro.vendor.fm.platform=connac2x

# GNSS
ro.vendor.gps.chrdev=gps_drv
ro.vendor.mtk_agps_app=1
ro.vendor.mtk_gps_support=1
ro.vendor.mtk_log_hide_gps=0
ro.vendor.mtk_wappush_support=1

# Init
ro.vendor.init.sensor.rc=init.sensor_2_0.rc
ro.vendor.rc=/vendor/etc/init/hw/

# IMS
persist.vendor.ims_support=1
persist.vendor.mims_support=1
persist.vendor.mtk.volte.enable=1
persist.vendor.mtk_dynamic_ims_switch=1
persist.vendor.mtk_wfc_support=1
persist.vendor.vilte_support=0
persist.vendor.volte_support=1
ro.vendor.md_auto_setup_ims=1

# LGE
ro.vendor.lge.build.target_country=COM
ro.vendor.lge.build.target_operator=LAO
ro.vendor.lge.capp_cupss.op.dir=/product
ro.vendor.lge.capp_cupss.rootdir=/product
ro.vendor.lge.product.type=generic
ro.vendor.lge.swversion=G900TM30g

# Media
debug.stagefright.c2inputsurface=-1
media.c2.dmabuf.padding=3072
media.stagefright.thumbnail.prefer_hw_codecs=true
ro.vendor.jpeg_decode_sw_opt=2
ro.vendor.mtk_config_max_dram_size=0x180000000
ro.vendor.mtk_hdr_video_support=1
ro.vendor.mtk_video_hevc_enc_support=1
vendor.mtk.vdec.frame.layout.mode=0
vendor.mtk.vdec.waitkeyframeforplay=9

# MediaTek
ro.vendor.mediatek.platform=MT6885
ro.vendor.mediatek.version.branch=alps-mp-s0.mp1.tc1sp
ro.vendor.mediatek.version.release=alps-mp-s0.mp1.tc1sp-V1.23_muse6883.64.hdk.s_P26

# Neural networks
debug.mtk_tflite.target_nnapi=29
ro.vendor.mtk_nn.option=A,B,C,D,E,F,G,Z
ro.vendor.mtk_nn_quant_preferred=1

# Radio
